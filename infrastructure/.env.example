# Use a long random value on a persistent server.
FASTY_DB_PASSWORD=

# Generate a separate long random value for JWT signing.
FASTY_JWT_SIGNING_KEY=

# Local development: bind the API to loopback only.
# Configure TLS and network restrictions before any non-local deployment.
FASTY_API_BIND=127.0.0.1

# Private beta mode: registration is enabled, accounts are usable immediately,
# and no verification or password-reset email is sent.
FASTY_REGISTRATION_ENABLED=true
FASTY_REGISTRATION_REQUIRE_EMAIL_VERIFICATION=false
FASTY_EMAIL_DELIVERY_ENABLED=false

# Google auth stays off until both client IDs are configured and tested.
# The server client ID is the Web OAuth client used by Android.
FASTY_GOOGLE_ENABLED=false
FASTY_GOOGLE_SERVER_CLIENT_ID=
FASTY_GOOGLE_DESKTOP_CLIENT_ID=
FASTY_GOOGLE_DESKTOP_CLIENT_SECRET=

# Keep these values ready for the secure-account branch, but do not enable
# delivery in this beta branch.
FASTY_EMAIL_PROVIDER=Smtp
FASTY_EMAIL_FROM_ADDRESS=noreply@example.com
FASTY_EMAIL_FROM_NAME=Fasty
FASTY_EMAIL_CONFIRMATION_URL=fasty://account/confirm-email
FASTY_EMAIL_PASSWORD_RESET_URL=fasty://account/reset-password

# Generic SMTP configuration. Real credentials belong only in infrastructure/.env.
FASTY_SMTP_HOST=smtp-relay.brevo.com
FASTY_SMTP_PORT=587
FASTY_SMTP_USERNAME=replace-with-smtp-username
FASTY_SMTP_PASSWORD=replace-with-smtp-key
FASTY_SMTP_USE_STARTTLS=true

# Optional alternative provider.
FASTY_RESEND_API_KEY=replace-with-resend-api-key

# Private, metadata-only monitoring listener.
# Bind only to localhost and expose later through private Tailscale Serve.
FASTY_MONITORING_ENABLED=false
FASTY_MONITORING_BIND=127.0.0.1
FASTY_MONITORING_REQUEST_CAPACITY=10000
FASTY_MONITORING_ACTION_CAPACITY=10000
FASTY_MONITORING_ANONYMIZATION_KEY=

# Persistent privacy-safe analytics
FASTY_DATA_DIR=./data
FASTY_ANALYTICS_SNAPSHOT_IMPORT_FILE=

# Read-only analytics archive planning.
# This only reports rows eligible for future archiving.
FASTY_ANALYTICS_ARCHIVE_PLANNING_ENABLED=false
FASTY_ANALYTICS_RETENTION_DAYS=90

# Local demo directory mounted writable only for analytics archives.
FASTY_ANALYTICS_ARCHIVE_DIR=./data/analytics-archive

# Archive path as seen inside the API container.
FASTY_ANALYTICS_ARCHIVE_DIRECTORY=/var/lib/fasty-analytics-archive

# Temporary private-beta admin-assisted password recovery.
FASTY_RECOVERY_ADMIN_ENABLED=false
FASTY_RECOVERY_ADMIN_SECRET=
FASTY_RECOVERY_ADMIN_CREDENTIAL_LIFETIME_MINUTES=30
